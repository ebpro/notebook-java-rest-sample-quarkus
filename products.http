# ------------------------------
# Tests pour ProductResource V1
# ------------------------------

### GET all products V1
# SGTP: GET /api/v1/products → 200 OK
# curl -s -X GET http://localhost:8080/api/v1/products | jq
GET http://localhost:8080/api/v1/products
Accept: application/json

### POST create product V1
# SGTP: POST /api/v1/products → 201 Created
# curl -s -X POST http://localhost:8080/api/v1/products \
#      -H "Content-Type: application/json" \
#      -d '{"sku":"P001","name":"Produit 1","price":12.5,"stock":100}' | jq
POST http://localhost:8080/api/v1/products
Content-Type: application/json

{
  "sku": "P001",
  "name": "Produit 1",
  "price": 12.5,
  "stock": 100
}

### POST create product V1 conflict
# SGTP: POST /api/v1/products → 409 Conflict
# curl -s -X POST http://localhost:8080/api/v1/products \
#      -H "Content-Type: application/json" \
#      -d '{"sku":"P001","name":"Produit 1 bis","price":15.0,"stock":50}' | jq
POST http://localhost:8080/api/v1/products
Content-Type: application/json

{
  "sku": "P001",
  "name": "Produit 1 bis",
  "price": 15.0,
  "stock": 50
}

