########################################
# Environnement
########################################

# Dev environment
@baseUrl = http://localhost:8080
# Staging environment
#@baseUrl = https://products.localhost:5443

########################################
# Tests ProductResource V1
# IN MEMO ONLY
########################################

### GET all products V1
GET {{baseUrl}}/api/v1/products
Accept: application/json

### POST create product V1
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "sku": "P001",
  "name": "Produit 1",
  "price": 12.5,
  "stock": 100
}

### POST create product V2
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "sku": "P002",
  "name": "Produit 2",
  "price": 15.0,
  "stock": 10
}

### POST create product V1 conflict
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "sku": "P001",
  "name": "Produit 1 bis",
  "price": 15.0,
  "stock": 50
}

