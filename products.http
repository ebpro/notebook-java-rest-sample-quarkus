# Tests ProductResource V2
########################################

### GET all products V2
GET {{baseUrl}}/api/v2/products
Accept: application/json

### GET product by SKU V2
GET {{baseUrl}}/api/v2/products/P001
Accept: application/json

### POST create product V2
POST {{baseUrl}}/api/v2/products
Content-Type: application/json

{
  "sku": "P002",
  "name": "Produit 2",
  "price": 20.0,
  "stock": 200
}

### DELETE product V2
DELETE {{baseUrl}}/api/v2/products/P002

