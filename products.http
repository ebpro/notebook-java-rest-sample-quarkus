# curl -s http://localhost:8080/api/v2/products/P001 | jq
GET http://localhost:8080/api/v2/products/P001
Accept: application/json

### POST create product V2
# SGTP: POST /api/v2/products → 201 Created
# curl -s -X POST http://localhost:8080/api/v2/products \
#      -H "Content-Type: application/json" \
#      -d '{"sku":"P002","name":"Produit 2","price":20.0,"stock":200}' | jq
POST http://localhost:8080/api/v2/products
Content-Type: application/json

{
  "sku": "P002",
  "name": "Produit 2",
  "price": 20.0,
  "stock": 200
}

### DELETE product V2
# SGTP: DELETE /api/v2/products/P002 → 204 No Content
# curl -s -X DELETE http://localhost:8080/api/v2/products/P002 -w "%{http_code}\n"
DELETE http://localhost:8080/api/v2/products/P002

